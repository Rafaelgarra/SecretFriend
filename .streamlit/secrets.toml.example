# Modelo dos segredos do app. NÃO coloque valores reais aqui.
# Local: copie para .streamlit/secrets.toml (ignorado pelo git) e preencha.
# Streamlit Cloud: cole o conteúdo preenchido em App > Settings > Secrets.

EMAIL_REMETENTE = "seu-email@gmail.com"
# Só para envio por SMTP (precisa da verificação em duas etapas). Com [gmail_api] abaixo, pode ficar vazio.
EMAIL_PASSWORD = "senha de app do Gmail (16 letras)"
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Use sempre a mesma chave: trocar impede ler os participantes já salvos.
ENCRYPTION_KEY = "chave Fernet"
APP_URL = "https://seu-app.streamlit.app"

# Envio pela API do Gmail (recomendado). Gere com: python scripts/autorizar_gmail.py client_secret.json
[gmail_api]
client_id = ""
client_secret = ""
refresh_token = ""

# Conteúdo do JSON da conta de serviço do Google (planilha AmigoSecretoDB)
[gcp_service_account]
type = "service_account"
project_id = ""
private_key_id = ""
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = ""
client_id = ""
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = ""
